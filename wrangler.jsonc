{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard. The self-reference
  // service below points at this same Worker, so the two names move together.
  "name": "rms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rms"
    }
  ],
  // Kept here rather than in the dashboard: `wrangler deploy` replaces the
  // Worker's variables with this list, so anything set by hand gets wiped.
  // Workers cannot fetch a bare IP address, so the API is reached by hostname.
  "vars": {
    "API_BASE_URL": "http://ec2-16-60-126-219.eu-west-2.compute.amazonaws.com"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
