{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard. The self-reference
  // service below points at this same Worker, so the two names move together.
  "name": "rms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rms"
    }
  ],
  // Kept here rather than in the dashboard: `wrangler deploy` replaces the
  // Worker's variables with this list, so anything set by hand gets wiped.
  // Workers cannot fetch a bare IP address, so the API is reached by hostname.
  // QA results from the in-app tester guide. Nothing to do with the research
  // databases: create with `npx wrangler kv namespace create QA_RESULTS` and
  // paste the id it prints over the placeholder below.
  "kv_namespaces": [
    { "binding": "QA_RESULTS", "id": "REPLACE_WITH_NAMESPACE_ID" }
  ],
  "vars": {
    "API_BASE_URL": "http://ec2-18-132-238-175.eu-west-2.compute.amazonaws.com"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
